# ==========================================
# ArthaGST Backend Production Environment Template
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database Connection String (Atlas Replica Set or Local MongoDB)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/arthagst?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/arthagst

# JWT Authentication Security
JWT_SECRET=your_ultra_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins, or empty to reflect requesting origin
CORS_ORIGIN=http://localhost:3000,https://app.arthagst.in

# Default Organization & Tenant Administrator Seed Credentials
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@artha.com
ADMIN_PASSWORD=Admin@12345
ADMIN_TENANT_CODE=ARTHA

# Platform Master Super Administrator Credentials (/sd console)
SUPERADMIN_NAME=Platform Super Administrator
SUPERADMIN_EMAIL=superadmin@artha.com
SUPERADMIN_PASSWORD=Superadmin@12345
SUPERADMIN_URL=/sd
