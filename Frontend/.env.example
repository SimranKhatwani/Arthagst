# ==========================================
# ArthaGST Frontend Production Environment Template
# ==========================================

# Backend API Base URL (Render Deployed Backend)
VITE_API_BASE_URL=https://arthagst-1.onrender.com/api

# Deployed Frontend Web Application URL
VITE_APP_URL=https://arthagst.vercel.app
VITE_FRONTEND_URL=https://arthagst.vercel.app

# Platform Super Admin Portal Path (/sd)
VITE_SUPERADMIN_URL=/sd

# Default Super Admin Seed Credentials (for quick login / demo defaults)
VITE_SUPERADMIN_EMAIL=superadmin@artha.com
VITE_SUPERADMIN_PASSWORD=Superadmin@12345

# Default Organization Admin Seed Credentials
VITE_DEFAULT_ORG_CODE=ARTHA
VITE_ADMIN_EMAIL=admin@artha.com
VITE_ADMIN_PASSWORD=Admin@12345
